# Copy to .env on the server and fill in EVERY value. Never commit .env.
# Make random secrets with:  openssl rand -base64 48

# Your free DuckDNS address (see docs/DEPLOY-ORACLE.md)
DOMAIN=yourname.duckdns.org

# MySQL: root is only used once to create the databases; the services log in as DB_USERNAME
MYSQL_ROOT_PASSWORD=
DB_USERNAME=campusfood
DB_PASSWORD=

# Signs login tokens - at least 48 random characters
JWT_SECRET=
# Shared keys between the gateway and the services
GATEWAY_KEY=
INTERNAL_KEY=

# The hidden admin account, created on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=
